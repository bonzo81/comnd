{
  "name": "comnd",
  "private": true,
  "version": "0.7.0",
  "description": "Cross-platform SSH client with context-aware command suggestions",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "node scripts/check-rust-coverage.mjs src-tauri/target/coverage.json",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:css": "stylelint \"src/styles/**/*.css\" && node scripts/check-css-tokens.mjs",
    "lint:eol": "node scripts/check-eol.mjs",
    "tauri": "tauri",
    "build:smoke": "tsc && vite build --mode smoke",
    "smoke": "node test/smoke/run.mjs",
    "smoke:mutation": "node test/smoke/run.mjs --mutation",
    "smoke:mutation:all": "node test/smoke/run.mjs --mutation=all",
    "smoke:netbox": "node test/smoke/netbox.mjs",
    "smoke:visual": "node test/smoke/visual.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "stylelint": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "webdriverio": "^10.2.0"
  }
}
