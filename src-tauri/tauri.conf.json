{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Comnd",
  "version": "0.3.0",
  "identifier": "com.comnd.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1450",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Comnd",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1OEU3RkYyMjI3RThDRDAKUldUUWpINGk4bitPNVdPVkRtbU1SYW91ZUwxNER3OVlDa09qVEtNY2tJTytFcDc0N1B0L2R5RnYK",
      "endpoints": [
        "https://github.com/bonzo81/comnd/releases/download/latest/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../knowledge-base/": "knowledge-base/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
